{
  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1;Port=5432;Database=repairflow;Username=repairflow;Password=change-me-local-only"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Database": {
    "MigrationDirectory": "Infrastructure/Database/Migrations"
  },
  "Auth": {
    "SessionCookieName": "repairflow_session",
    "SecureCookie": false,
    "IdleTimeoutMinutes": 30,
    "AbsoluteSessionLifetimeHours": 8,
    "PasswordHashIterations": 600000,
    "PasswordHashSaltBytes": 16,
    "PasswordHashBytes": 32,
    "SessionTokenBytes": 32,
    "MaxFailedAttempts": 5,
    "FailureWindowMinutes": 15,
    "UserAgentMaxLength": 512
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
