@startuml repairflow-usecase-overview

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45

title RepairFlow — Use Case Overview

actor "Owner / Manager" as management
actor Receptionist as receptionist
actor Technician as technician
actor Customer as customer

rectangle "RepairFlow" {

    package "Internal operations" {
        package "Access & visibility" {
            usecase "Truy cập workspace" as access
            usecase "Theo dõi dashboard\nvà công việc được giao" as monitor
            usecase "Tra cứu lịch sử\nvà timeline" as history
        }

        package "Repair workflow" {
            usecase "Tiếp nhận thiết bị\nvà ghi hiện trạng" as intake
            usecase "Chẩn đoán và lập\nbáo giá nháp" as diagnosis
            usecase "Phát hành báo giá\nvà cấp customer link" as publish
            usecase "Thực hiện\nsửa chữa" as repair
            usecase "Kiểm tra\nchất lượng" as quality
            usecase "Bàn giao và kích hoạt\nbảo hành" as handover
        }
    }

    package "Customer link" {
        usecase "Xem và quyết định\nbáo giá" as decision
    }
}

' Liên kết thể hiện actor có thể trực tiếp thực hiện use case.
management --> access
management --> monitor
management --> history
management --> intake
management --> diagnosis
management --> publish
management --> repair
management --> quality
management --> handover

receptionist --> access
receptionist --> monitor
receptionist --> history
receptionist --> intake
receptionist --> publish
receptionist --> handover

technician --> access
technician --> monitor
technician --> history
technician --> intake
technician --> diagnosis
technician --> repair
technician --> quality

customer --> decision

@enduml
