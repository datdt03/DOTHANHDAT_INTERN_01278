ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5191

VITE_API_BASE_URL=http://127.0.0.1:5191
VITE_API_TIMEOUT_MS=5000
VITE_UI_PREVIEW=false
VITE_UI_HOST=127.0.0.1
VITE_UI_PORT=5173
VITE_PREVIEW_PORT=4173

POSTGRES_HOST=127.0.0.1
POSTGRES_DB=repairflow
POSTGRES_USER=repairflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173

MINIO_ROOT_USER=repairflow-local
MINIO_ROOT_PASSWORD=change-me-local-only
